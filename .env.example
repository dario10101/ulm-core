# Copiar a .env (ignorado por git) y completar. Todo lo que no aparece aca
# tiene un valor por defecto para desarrollo en app/core/config.py.

DATABASE_URL=postgresql+psycopg2://ulm_user:ulm_password@localhost:5432/ulm_db

# Google Cloud Console > Google Auth Platform > Clients (tipo Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir exacto con la "Authorized redirect URI" del cliente.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback
# ID del proyecto (no el numero). Solo para el link a la lista de test users.
GOOGLE_CLOUD_PROJECT=

# Firma la cookie temporal del login. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# invite_only (por defecto) | open
REGISTRATION_MODE=invite_only

# Admins (separados por coma): todos los permisos, y entran sin invitacion.
ADMIN_EMAILS=

# Produccion: true (exige HTTPS). Local: false.
SESSION_COOKIE_SECURE=false

# Festivos que propone Settings -> Calendar events (libreria `holidays`).
HOLIDAYS_COUNTRY=CO
HOLIDAYS_LANGUAGE=es

# IA (permiso `ai`). Sin key, /ai responde 503. Fijar un limite de gasto en el
# dashboard de OpenAI: es la unica proteccion real del saldo.
OPENAI_API_KEY=
# Preseleccionado en la UI; uno de app/services/ai_models.py.
OPENAI_MODEL=gpt-6-luna

# Blog: secciones habilitadas a la vez y topes contra abuso (ver PLAN-BLOG.md).
BLOG_MAX_ENABLED_SECTIONS=6
BLOG_MAX_SECTIONS=20
BLOG_MAX_GROUPS_PER_SECTION=20
BLOG_MAX_ITEMS_PER_SECTION=200
BLOG_MAX_MD_BYTES=200000
